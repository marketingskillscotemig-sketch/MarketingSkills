# Ambiente: development (local) ou production (servidor).
# Sem APP_ENV, a aplicação assume production.
APP_ENV=production

# OBRIGATÓRIO false em produção: a aplicação
# não inicia com debug ativo em production.
FLASK_DEBUG=false

# Em produção: mínimo de 32 caracteres. Gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
# Nunca commite a chave real.
SECRET_KEY=change-this-value

# Produção: true (exige HTTPS). Local via HTTP: false.
SESSION_COOKIE_SECURE=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=market_skills
DB_USER=root
DB_PASSWORD=your-mysql-password

CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500